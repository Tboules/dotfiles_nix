theme = Nightfox

font-size = 17
font-family = "JetBrainsMono Nerd Font Mono"

macos-titlebar-style = "hidden"

# Left option acts as alt (needed for herdr's alt+1..9 agent jumps);
# right option still composes special characters.
macos-option-as-alt = left

#background-blur = macos-glass-clear
#background-opacity = 0.9

window-padding-x = 8
window-padding-y = 16
